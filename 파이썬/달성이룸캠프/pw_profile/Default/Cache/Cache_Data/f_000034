.progress-circle {
    position: relative; /* so that children can be absolutely positioned */
    padding: 0;
    width: 21px;
    height: 21px;
    background-color: var(--keyrgba20);
    border-radius: 50%;
    line-height: 21px;
    display: inline-block;
}

.progress-circle:after{
    border: none;
    position: absolute;
    top: 2px;
    left: 2px;
    text-align: center;
    display: block;
    border-radius: 50%;
    width: 17px;
    height: 17px;
    background-color:#fff;
    content: " ";
}
.classRoomRight .playListWrap li a .progress-circle:after{
    background-color: #f6f6f9;
}
.classRoomRight .playListWrap li:hover a .progress-circle:after,
.classRoomRight .playListWrap li.on a .progress-circle:after{
    background-color: var(--subcolor1);
}
/* Text inside the control */
.progress-circle span {
    position: absolute;
    line-height: 21px;
    width: 21px;
    text-align: center;
    display: block;
    color: #53777A;
    z-index: 2;
}
.left-half-clipper {
    /* a round circle */
    border-radius: 50%;
    width: 21px;
    height: 21px;
    position: absolute; /* needed for clipping */
    clip: rect(0, 21px, 21px, 10.5px); /* clips the whole left half*/
}
/* when p>50, don't clip left half*/
.progress-circle.over50 .left-half-clipper {
    clip: rect(auto,auto,auto,auto);
}
.value-bar {
    /*This is an overlayed square, that is made round with the border radius,
    then it is cut to display only the left half, then rotated clockwise
    to escape the outer clipping path.*/
    position: absolute; /*needed for clipping*/
    clip: rect(0, 10.5px, 21px, 0);
    width: 21px;
    height: 21px;
    border-radius: 50%;
    border: 2px solid var(--keycolor); /*The border is 0.35 but making it larger removes visual artifacts */
    /*background-color: #4D642D;*/ /* for debug */
    box-sizing: border-box;

}
/* Progress bar filling the whole right half for values above 50% */
.progress-circle.over50 .first50-bar {
    /*Progress bar for the first 50%, filling the whole right half*/
    position: absolute; /*needed for clipping*/
    clip: rect(0, 21px, 21px, 10.5px);
    background-color: var(--keycolor);
    border-radius: 50%;
    width: 21px;
    height: 21px;
}
.progress-circle:not(.over50) .first50-bar{ display: none; }


