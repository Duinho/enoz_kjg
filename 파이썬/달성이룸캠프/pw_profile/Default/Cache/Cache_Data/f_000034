/*====================================
           내 강의실 헤더
====================================*/
#classHeader{
    display: block !important;
    position: relative;
    top: 0;
    right: 0;
    left: 0;
    background-color: #fff;
    -webkit-transition: all 0.3s ease-in-out;
    -moz-transition: all 0.3s ease-in-out;
    -o-transition: all 0.3s ease-in-out;
    -ms-transition: all 0.3s ease-in-out;
    transition: all 0.3s ease-in-out;
    position: fixed;
    top: 0;
    z-index:99;
}
#classHeader .classHd-wrap {
    height: 71px;
    display: inline-block;
    width: 100%;
    border-bottom: 1px solid #ddd;
    vertical-align: middle;
}
#classHeader #classMenu{
    position: absolute;
    z-index: 0;
    top: 0px;
    -webkit-transition: all 0.3s ease-in-out;
    -moz-transition: all 0.3s ease-in-out;
    -o-transition: all 0.3s ease-in-out;
    -ms-transition: all 0.3s ease-in-out;
    transition: all 0.3s ease-in-out;
    cursor: pointer;
    margin-right: 20px;
    width: 22px;
    height: 18px;
    left: 30px;
    top: 50%;
    margin-top: -9px;
    z-index: 1;
}
#classHeader #classMenu span,
#classHeader #classMenu span:before,
#classHeader #classMenu span:after{
    cursor: pointer;
    height: 2px;
    width: 22px;
    background: #000;
    position: absolute;
    display: block;
    content: '';
    border-radius:10px;
}
#classHeader #classMenu span{
    top:50%;
    margin-top:-1.5px;
}
#classHeader #classMenu span:before{
    top: -8px;
    width:22px;
    left:0;
}
#classHeader #classMenu span:after{
    top: 8px;
    width: 22px;
    left: 0;
    margin-top: 0;
}
#classHeader #classMenu span, #classHeader #classMenu span:before, #classHeader #classMenu span:after {
    transition: all 500ms ease-in-out;
}
#classHeader .classTitle{
    width: 100%;
    padding-right: 20px;
    padding-left:72px;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
}
#classHeader .previewHd .classTitle{
    padding-right: 20px;
    padding-left:20px;
}
#classHeader .classTitle .lectureName{
    font-size:16px;
    font-weight: 500;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}
#classHeader .classTitle ul{
    width: 100%;
    display: inline-block;
    margin-top: 6px;
}
#classHeader .classTitle li{
    float: left;
    color: #777;
    font-size:14px;
    position: relative;
    padding:0 8px;
}
#classHeader .classTitle li:first-child{
    padding-left: 0;
}
#classHeader .classTitle li:last-child{
    padding-right: 0;
}
#classHeader .classTitle li:after{
    content:'';
    width: 1px;
    height: 12px;
    background-color: #777;
    position: absolute;
    right: 0;
    top: 50%;
    margin-top: -6px;
}
#classHeader .classTitle li:last-child:after{
    display: none;
}
.class_wsmain .m_top{
