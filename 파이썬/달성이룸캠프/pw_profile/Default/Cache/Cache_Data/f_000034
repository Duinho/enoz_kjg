    margin:20px 0;
}
.class_wsmain .class_wsmenu-list li {
    margin:0 20px 0px 0;
}
.class_wsmain .class_wsmenu-list > li > a {
    font-size:14px;
    width: 100%;
    display: inline-block;
    padding: 13px 15px 13px 19px;
}
.class_wsmain .class_wsmenu-list > li.active a{
    background: var(--keycolor);
