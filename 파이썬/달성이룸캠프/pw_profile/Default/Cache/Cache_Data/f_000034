}

.class_wsmain .player_notice{
    width: calc(100% - 40px);
    margin: 0 20px;
    padding: 15px;
    background: #f4f4f4;
    font-size: 13px;
}
.class_wsmain .player_notice strong{
    width: 100%;
    display: inline-block;
    font-weight: bold;
    font-size: 13px;
    margin-bottom: 5px;
    word-break: keep-all;
}
.class_wsmain .player_notice div{margin-bottom: 5px; line-height: 16px; word-break: keep-all;}
.class_wsmain .player_notice div:last-child{margin-bottom: 0;}

.shortcut_menu {
    padding: 20px 0;
    border-top: 1px solid #ddd;
    border-bottom: 1px solid #ddd;
    margin-bottom: 30px;
}
.shortcut_menu a {
    font-size:14px;
    width: 100%;
    display: inline-block;
    padding: 13px 15px 13px 19px;
}
.shortcut_menu a:hover{
    background: var(--keyrgba10);
    color: #333;
    border-radius: 0 50px 50px 0;
}
@media all and (max-width:1400px) {
    .classRoomWrap{
        padding-left:0px;
    }
    .class_wsmain .m_top{
        display: block;
    }

    .class_wsmain .close_li {
        position: relative;
        padding: 16px 15px;
        border-bottom: 1px solid #ddd;
        text-align: left;
    }

    .class_wsmain .close_li .logo {
        display: inline-block;
    }

    .class_wsmain .close_li .logo img {
        width: 110px;
    }

    .class_wsmain .close {
        position: absolute;
        right: 15px;
        top: 50%;
        margin-top:-8.5px;
        width: 17px;
        height: 17px;
        background: url(../images/mobile/icon_close.png) 50% 50% no-repeat;
        -webkit-background-size: contain;
        background-size: contain;
    }
    .class_wsmain .clientLink{
        display: none;
    }
    body.off .class_wsmain {
        left: -240px;
    }



    .class_wsmain {
        top: 0;
        left: -100%;
        height: 100%;
        transition: 0.3s;
        box-shadow:none;
        z-index: 250;
    }

    .class_wsmain.on {
        display: block;
        left: 0%;
        transition: 0.3s;
    }
    .class_wsmain + .bg_000 {
        background: rgba(0, 0, 0, 0.2);
    }

    .class_wsmain.on + .bg_000 {
        display: block;
        opacity: 1;
    }
}
@media all and (max-width:599px) {
    #classHeader #classMenu{
        left:15px;
        margin-right: 20px;
        top: 50%;
        margin-top: -9px;
    }
    #classHeader .classHd-wrap{
        height:50px;
    }
    #classHeader .classTitle{
        padding:17px 0;
        padding-left:52px;
    }
    #classHeader .previewHd .classTitle{
        padding-right: 15px;
        padding-left:15px;
    }
    #classHeader .classTitle{
        font-size: 16px;
    }
}

