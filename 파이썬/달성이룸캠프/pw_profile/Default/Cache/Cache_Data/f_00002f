/*gnb*/
#header_pc .gnb {
    border-bottom: 1px solid #ddd;
    height: 56px;
    color: #000;
    text-align: center;
}

#header_pc .gnb.on {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 99;
    background: #fff;
    width: 100%;
    border-bottom: 1px solid #ddd;
}

#header_pc .gnb.on .ol {
    box-shadow: 0 4px 10px 5px rgba(0, 0, 0, 0.05);
}

#header_pc .gnb .gnbWrap {
    max-width: 1200px;
    width: 100%;
    width: 100%;
    margin: 0 auto;
    position: relative;
}

#header_pc .gnb .allcatebtn {
    background: transparent;
    border: none;
    width: 56px;
    height: 56px;
    position: absolute;
    left: 0;
    top: 0%;
    border-left: 1px solid #ddd;
    border-right: 1px solid #ddd;
}

#header_pc .gnb .allcatebtn span {
    width: 20px;
    height: 2px;
    background: #333;
    position: absolute;
    text-indent: -9999px;
    left: 18px;
    top: 26px;
    font-size: 0
}

#header_pc .gnb .allcatebtn span:before {
    content: '';
    width: 15px;
    height: 2px;
    background: #333;
    position: absolute;
    left: 0;
    margin-top: -6px;
}

#header_pc .gnb .allcatebtn span:after {
    content: '';
    width: 15px;
    height: 2px;
    background: #333;
    position: absolute;
    left: 0;
    margin-top: 6px;
}

#header_pc .gnb ul.gnb_ul {
    display: inline-block;
    padding: 19px 200px 18px 0;
    width: 100%;
}
#header_pc .gnb ul.gnb_ul.full_gnb_menu{
    /*padding:19px 70px 18px 70px;*/
    padding:19px 20px 18px 20px;
}
#header_pc .gnb ul.gnb_ul li {
    float: none;
    display: inline-block;
    position: relative;
    text-align: left;
}

#header_pc .gnb ul li a {
    position: relative;
    padding: 0 42px;
    font-size: 17px;
    color: #333;
    font-weight: 500;
}

#header_pc .gnb ul li a .border_span {
    font-size: 17px;
    color: #333;
    font-weight: 500;
    padding: 16px 0;
    position: relative;
}
#header_pc .gnb ul li:hover a .border_span {
    color:var(--keycolor);
}
#header_pc .gnb ul li.on a .border_span:after,
#header_pc .gnb ul li:hover a .border_span:after {
    content: '';
    width: 100%;
    height: 4px;
    background: var(--keycolor);
    position: absolute;
    left: 0;
    bottom: -2px;
    z-index: 11;
}
#header_pc .gnb ul li a .border_span {
    transition:all .3s ease
}
#header_pc .gnb ul li a:hover{transition:all .3s ease; }
#header_pc .gnb ul li a:hover .border_span{ color:var(--keycolor);}
#header_pc .gnb ul li a .border_span { position:relative }

#header_pc .gnb ul li a .border_span::after {
    content: '';
    width: 0%;
    left: 50%;
    height: 4px;
    display: block;
    position: absolute;
    bottom: -2px;
    transition:all .3s ease;
}
#header_pc .gnb ul li a:hover .border_span::after {
    content: '';
    left: 0px;
}

#header_pc .gnbWrap > ul.gnb_ul > li > a {
    padding: 15px 30px;
}

#header_pc .gnb ul li.on > a {
    color: var(--keycolor);
    position: relative;
}

#header_pc .gnb ul li .ol {
    display: none;
    position: absolute;
    overflow: hidden;
    z-index: 55;
    width: auto;
    height: auto;
    top: 37px;
    left: 50%;
    transform: translateX(-50%);
    border: 1px solid #ddd;
    border-top: none;
    background: #fff;
}

#header_pc .gnb ul li .ol ol {
}

#header_pc .gnb ul li .ol:after {
    display: block;
    content: '';
    clear: both;
}

#header_pc .gnb ul > li:first-child .ol.img_ol {
    margin-left: 0;
    transform: translateX(0);
    left: 0;
}

#header_pc .gnb ul > li:last-child .ol.img_ol {
    margin-left: 0;
    transform: translateX(0);
    left: auto;
    right: 0;
}

#header_pc .gnb ul li .ol li {
    float: left;
    width: 100%;
    line-height: 1.7;
    margin-bottom: 9px;
}

#header_pc .gnb ul li .ol li:last-child {
    margin-bottom: 0;
}

#header_pc .gnb ul li .ol li:first-child a {
    padding-top: 2em;
}

#header_pc .gnb ul li .ol li:last-child a {
    padding-bottom: 2em;
}

#header_pc .gnb ul li .ol li a {
    font-size: 15px;
    display: block;
    white-space: nowrap;
    transition: 0.2s;
}

#header_pc .gnb ul li.on .ol li.on a {
    color: var(--keycolor);
}

#header_pc .gnb ul li .ol li:hover a {
    color: var(--keycolor);
}

#header_pc .gnb ul li .ol li.on a {
    color: var(--keycolor);
}

/*gnb 내강의실*/
