/* 전체메뉴 펼치기 */
#header_pc #allmenu {
    visibility: hidden;
    position: fixed;
    width: 100%;
    height: 0;
    background: #fff;
    z-index: 998;
    opacity: 0;
}

#header_pc #allmenu.on {
    visibility: visible;
    height: auto;
    top: 0;
    left: 0;
    transition: all .3s;
    -webkit-transition: all .3s;
    -moz-transition: all .3s;
    -o-transition: all .3s;
    opacity: 1
}

#header_pc #allmenu .catebtn_close {
    display: block;
    position: absolute;
    top: -5px;
    right: 0;
    overflow: hidden;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 0;
    padding: 12px;
}

