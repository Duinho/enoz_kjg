/* 탭메뉴 */

.tab_menu {
    width: 40%;
    margin: 0 auto 4em;
}

.tab_menu.event_tab {
    width: 27.5%;
}

.tab_menu li a {
    display: block;
    padding: 1em 0;
    background-color: #fff;
    color: #999;
    border: 1px solid #ddd;
}

.tab_menu li.on a {
    border: 1px solid var(--keycolor);
    background-color: var(--keycolor);
    color: #fff;
}

