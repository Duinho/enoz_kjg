function use_coupon(){  //쿠폰사용
	var form = document.orderForm;
	var trade_price =  $("#trade_goods_price").val();
	var trade_use_coupon = 0;
	//var trade_deliv_price_temp = form.trade_deliv_price_temp.value;

	var coupon_cnt = $("#coupon_cnt").val();
	var totalCouponPrice = 0;
	var freeCouponIncluded = "N";
	var trade_use_coupon_idx = new Array();
	var trade_use_coupon_goods = new Array();
	var coupon_price = new Array();

	for (var ct = 0; ct < coupon_cnt; ct++) {
		if (document.getElementById("use_coupon[" + ct + "]").checked == true) {

			var cArr = document.getElementById("use_coupon[" + ct + "]").value.split("||", 5);

			var disAmount = 0;
			trade_use_coupon_idx[ct] = cArr[0];
			trade_use_coupon_idx.join(',');

			var use_goods = document.getElementById("use_goods[" + ct + "]").value;
			var use_goods_Arr = use_goods.split("||");
			var dc_rate = use_goods_Arr[1];
			var goods_idx = use_goods_Arr[0];
			var goods_price = use_goods_Arr[3];
			trade_use_coupon_goods[ct] = use_goods;
			trade_use_coupon_goods.join(',');

			//alert(cArr[4]);
			/*
			if (cArr[1] == "free") {
				disAmount = parseInt(form.trade_goods_total_price.value);
				freeCouponIncluded = "Y";
			} else
			*/

			if(cArr[1] == "delivery"){
				//disAmount = parseInt(form.trade_deliv_price.value);
				//form.trade_deliv_price.value = form.trade_deliv_price_temp.value;
				//alert(disAmount);
			} else {
				if (cArr[4] == "rate") disAmount = parseInt(goods_price) * parseInt(dc_rate) / 100;
				else disAmount = parseInt(cArr[3]);
				if( typeof coupon_price[ goods_idx ] == "undefined" ){
					coupon_price[ goods_idx ] = 0;
				}
				let tmp_price = disAmount + coupon_price[ goods_idx ];
				if( tmp_price > goods_price ){
					disAmount = goods_price - coupon_price[ goods_idx ];
				}
				coupon_price[ goods_idx ] += disAmount;
				//form.trade_deliv_price.value = form.trade_deliv_price_temp.value;
			}
			totalCouponPrice += disAmount;
		}
	}

	if (freeCouponIncluded == "N") {
		//alert(totalCouponPrice);
		if (totalCouponPrice > parseInt(form.trade_goods_price.value)) {
			form.trade_use_coupon.value = form.trade_goods_price.value;
		} else {
			form.trade_use_coupon.value = totalCouponPrice;
		}
	} else {
		form.trade_use_coupon.value = form.trade_goods_price.value; // 강좌 전액적용
	}

	$("#trade_use_coupon").html(addCommas(parseInt(form.trade_use_coupon.value)));
	$("#trade_use_coupon_idx").val(trade_use_coupon_idx);
	$("#trade_use_coupon_goods").val(trade_use_coupon_goods);

	if(totalCouponPrice  >= parseInt(form.trade_goods_price.value)){ // 쿠폰 전액 구매시 적립포인트 0
		form.trade_save_point.value=0;
	} else {
		form.trade_save_point.value=form.trade_save_point_temp.value;
	}

	discount(); //할인금액 계산

}


function discount(){ // 할인금액 계산
	var form = document.orderForm;
	var coupon_price = form.trade_use_coupon.value;
	var point_price;
	if(form.trade_use_point.value==""){
		var point_price = 0;
	} else {
		var point_price = form.trade_use_point.value;
	}
	var trade_dc_price = form.trade_dc_price.value;
	var trade_goods_price = form.trade_goods_price.value;
	var deliv_price = form.trade_deliv_price.value;
	var total_price_temp = form.total_price_temp.value;

	var dc_price = parseInt(coupon_price) + parseInt(point_price);

	if(dc_price >= trade_goods_price){
		dc_price = trade_goods_price;
	}

	var total_price = parseInt(trade_goods_price) + parseInt(deliv_price) - dc_price ;

