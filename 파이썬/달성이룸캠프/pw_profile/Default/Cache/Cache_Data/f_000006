$.fn.layer_popup = function( options ){

	var this_el = $(this);

	// 옵션에 기본값을 주는 간단한 방법입니다.
	var settings = {
		open_id : $(this).attr('btn') == undefined ? "" : $(this).attr('btn'),
		close_btn : this_el.find(".close_btn"),
		popup_box : this_el.find(".lay_box"),
		left : 0,               // 좌측위치
		top : 0,                // 우측위치
		width : 0,              // 넓이
		height : 0,             // 높이/
		center : true,          // 중간정렬( true경우 left, top는 무시 )
		_close : function(){},
		_open : function(){},
		_init : function(){},
	};

	if( typeof options !== "undefined" ){
		$.extend(settings, options );
	}

	$(settings.close_btn).click(function(){
		settings._close();
		$(this_el).removeClass('on');
	});

	$(settings.open_id).click(function(){
		$(this_el).addClass('on');
		if( settings.width ){
			$(settings.popup_box).css("width" , settings.width);
		}
		if( settings.height ){
			$(settings.popup_box).css("top" , settings.height);
		}
		if( settings.center ){
			$(settings.popup_box).css({
				"marginTop": ((-$(settings.popup_box).outerHeight())/2)+"px",
				"marginLeft": ((-$(settings.popup_box).outerWidth())/2)+"px"
				//팝업창을 가운데로 띄우기 위해 현재 화면의 가운데 값과 스크롤 값을 계산하여 팝업창 CSS 설정
			});
		}else{
			$(settings.popup_box).css("left" , settings.left);
			$(settings.popup_box).css("top" , settings.top);

		}
		settings._open();
	});
}

